---
import '../styles/global.css';
import HeadMeta from '../components/HeadMeta.astro';
import HubApp from '../components/HubApp';
import { hasConfiguredHubToken } from '../templates/prompt';

const processEnvToken = (
  globalThis as { process?: { env?: Record<string, string | undefined> } }
).process?.env?.UI_HUB_TOKEN;
const bearerAuthAvailable = hasConfiguredHubToken(
  import.meta.env.UI_HUB_TOKEN ?? processEnvToken,
);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <HeadMeta
      title="UI Template Hub — Live Previews & Agent-Ready UI Manifests"
      description="Static UI template registry with interactive Desktop, Tablet, and Mobile previews, live visual customization, inspect boundaries, and copy-ready /r/<slug>.md manifests for coding agents."
      themeColor="#0A0A0B"
      colorScheme="dark"
    />
  </head>
  <body class="bg-[#0A0A0B] text-zinc-100 antialiased selection:bg-sky-500/30 selection:text-sky-100">
    <HubApp client:load bearerAuthAvailable={bearerAuthAvailable} />
  </body>
</html>
