---
import '../../styles/global.css';
import TemplateFullscreenPreview from '../../components/TemplateFullscreenPreview';
import { getAllTemplates, type TemplateEntry } from '../../templates/registry';

export const prerender = true;

export function getStaticPaths() {
  return getAllTemplates().map((template) => ({
    params: { slug: template.meta.slug },
    props: { template },
  }));
}

const { template } = Astro.props as { template: TemplateEntry };
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{template.meta.name} — UI Template Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    style={`background-color: ${template.meta.swatchBg}`}
    class="min-h-screen antialiased"
  >
    <TemplateFullscreenPreview slug={template.meta.slug} client:load />
  </body>
</html>
