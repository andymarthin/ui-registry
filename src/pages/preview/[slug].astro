---
import '../../styles/global.css';
import HeadMeta from '../../components/HeadMeta.astro';
import TemplateFullscreenPreview from '../../components/TemplateFullscreenPreview';
import { getAllTemplates, type TemplateEntry } from '../../templates/registry';

export const prerender = true;

export function getStaticPaths() {
  return getAllTemplates().map((template) => ({
    params: { slug: template.meta.slug },
    props: { template },
  }));
}

const { template } = Astro.props as { template: TemplateEntry };
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <HeadMeta
      title={`${template.meta.name} (${template.meta.styleTag}) — UI Template Hub`}
      description={`${template.meta.description} Style: ${template.meta.styleFull}. Category: ${template.meta.category}.`}
      themeColor={template.meta.swatchBg}
      colorScheme="dark light"
      ogImageAlt={`${template.meta.name} — ${template.meta.styleFull} template preview on UI Template Hub`}
    />
  </head>
  <body
    style={`background-color: ${template.meta.swatchBg}`}
    class="min-h-screen antialiased"
  >
    <TemplateFullscreenPreview slug={template.meta.slug} client:load />
  </body>
</html>
