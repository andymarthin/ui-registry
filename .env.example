# Optional: pin a canonical public base URL for the Hub Base URL bar and 1-Line Prompt generator.
# No .env file is required — leave unset or commented out to auto-detect the current host (window.location.origin) at runtime.
# PUBLIC_HUB_URL=https://ui.example.com

# Optional: set at build time to enable the "Bearer Auth Header" toggle in the Agent Prompt Builder.
# Only a boolean presence check runs at build time (in Astro frontmatter); the token value is never bundled into dist/.
# UI_HUB_TOKEN=
